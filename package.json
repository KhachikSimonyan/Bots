{
  "name": "khnayik-mini-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dev-server.cjs",
    "check": "node --check src/app.js && node --check bot/worker.js && node --check dev-server.cjs",
    "db:create": "wrangler d1 create khnayik-db",
    "db:migrate": "wrangler d1 execute khnayik-db --remote --file=./schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
